<?xml version="1.0" encoding="utf-8"?>
<!-- Cyberpunk secondary action: dark panel, sharp corners, magenta neon double-line border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_pink_glow" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cyber_panel"
                android:endColor="@color/cyber_black"
                android:angle="90" />
            <corners android:radius="0dp" />
            <stroke
                android:width="2dp"
                android:color="@color/cyber_pink" />
            <padding android:left="5dip" android:top="8dip" android:right="5dip" android:bottom="8dip" />
        </shape>
    </item>
</layer-list>
