<?xml version="1.0" encoding="utf-8"?>
<!-- Cyberpunk cancel/danger action: dark panel, sharp corners, warning-red neon border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66FF1F5E" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cyber_panel"
                android:endColor="@color/cyber_black"
                android:angle="90" />
            <corners android:radius="0dp" />
            <stroke
                android:width="2dp"
                android:color="#FF1F5E" />
            <padding android:left="0dip" android:top="0dip" android:right="0dip" android:bottom="0dip" />
        </shape>
    </item>
</layer-list>
