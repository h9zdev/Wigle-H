        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/cyber_pink</item>
    </style>
    <style name="NewsTitleStyle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/share_tech_mono_family</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="NewsDateStyle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cyber_text_dim</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="NewsPostStyle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">start</item>
    </style>
    <style name="ToastStyle">
        <item name="android:color">#CC000008</item>
    </style>
    <style name="MapOverlay">
        <item name="android:background">#DD000005</item>
    </style>
    <style name="NetworkViewOverlay">
        <item name="android:background">#DD0B0B14</item>
    </style>
    <!-- Section titles on the Data tab (replaces ?android:attr/listSeparatorTextViewStyle). -->
    <style name="WiGLESectionHeader" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/share_tech_mono_family</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <!-- Match list-separator weight: plain TextAppearance.AppCompat body reads lighter than ?listSeparatorTextViewStyle. -->
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WiGLESectionHeader.Large" parent="WiGLESectionHeader">
        <item name="android:textSize">20sp</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="NetDetailSsid">
        <item name="android:fontFamily">@font/share_tech_mono_family</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/cyber_cyan</item>
    </style>
    <style name="NetDetailBssid">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/cyber_pink</item>
    </style>
    <style name="NetDetailOui">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cyber_text_dim</item>
    </style>
